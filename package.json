    "axios": "^1.9.0",
    "body-parser": "^2.2.0",
    "connect-typeorm": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "ldapjs": "^3.0.7",
    "lodash": "^4.17.21",
    "method-override": "^3.0.0",
    "mime": "^4.0.7",
    "multer": "^2.0.1",
    "mysql2": "^3.14.1",
    "node-cron": "^4.1.0",
    "node-latex": "^3.1.0",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-ldapauth": "^3.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "prettier": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "strong-error-handler": "^5.0.19",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0",
    "validator": "^13.15.15"
